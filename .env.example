# ─────────────────────────────────────────────────────────────────────────
# ReviewIQ — example environment. Copy to `.env` and fill in secrets.
#   cp .env.example .env
# `.env` is gitignored; `.env.example` is committed as documentation.
# ─────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ── Security (Phase 2) ─────────────────────────────────────────────────────
# Generate a strong one:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-change-me-generate-a-real-secret-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encrypts GitHub tokens at rest. Leave blank in dev (derived from JWT_SECRET).
# Generate:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Session cookie carrying the JWT (httpOnly). Set COOKIE_SECURE=true in production.
COOKIE_NAME=reviewiq_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── GitHub OAuth (Phase 2/3) ───────────────────────────────────────────────
# Create at: https://github.com/settings/developers  (New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# ── Postgres (Phase 1) ─────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=reviewiq
POSTGRES_PASSWORD=reviewiq
POSTGRES_DB=reviewiq

# ── Redis (Phase 4 — Celery broker/result backend) ─────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Qdrant vector DB (Phase 4) ─────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=reviewiq_code_chunks

# ── Semantic search (Phase 5) ──────────────────────────────────────────────
# Default number of nearest code chunks a search returns (per-request override 1–50).
SEARCH_TOP_K=10

# ── AI providers (Phase 4/6) — local-first, $0 by default ───────────────────
# LLM: ollama (local, free) | openai (paid). Swap without code changes.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings: local (BGE/E5 via sentence-transformers, free) | openai (paid)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBED_BATCH_SIZE=64

# ── Workers + indexing (Phase 4) ───────────────────────────────────────────
# EAGER=true runs Celery tasks inline (no worker) — handy for quick local runs/tests.
CELERY_TASK_ALWAYS_EAGER=false
CLONE_DIR=/tmp/reviewiq-clones
CHUNK_MAX_LINES=60
CHUNK_OVERLAP_LINES=10
INDEX_MAX_FILE_BYTES=200000
